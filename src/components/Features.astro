---
export interface Props {
  post: any;
}

const { post } = Astro.props;

const blocks = [
  {
    title: post.frontmatter.block1title,
    text: post.frontmatter.block1text,
    // magnifying glass — sourcing / recruitment
    path: "M116,24a92,92,0,1,0,92,92A92.1,92.1,0,0,0,116,24Zm0,168a76,76,0,1,1,76-76A76.08,76.08,0,0,1,116,192Zm113.66,25.66a8,8,0,0,1-11.32,11.32l-50.06-50.07a92.14,92.14,0,0,0,11.31-11.31Z",
  },
  {
    title: post.frontmatter.block2title,
    text: post.frontmatter.block2text,
    // document/contract — employer of record, payroll & compliance
    path: "M213.66,82.34l-56-56A8,8,0,0,0,152,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V88A8,8,0,0,0,213.66,82.34ZM160,51.31,188.69,80H160ZM200,216H56V40h88V88a8,8,0,0,0,8,8h48V216Zm-32-80a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,136Zm0,32a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,168Z",
  },
  {
    title: post.frontmatter.block3title,
    text: post.frontmatter.block3text,
    // compass — navigating expansion
    path: "M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm44.42-140.42-64,24a8,8,0,0,0-4.75,4.75l-24,64a8,8,0,0,0,10.29,10.29l64-24a8,8,0,0,0,4.75-4.75l24-64a8,8,0,0,0-10.29-10.29ZM139.68,139.68,98.94,155l15.36-40.94L155,98.94Z",
  },
].filter((block) => block.title);
---
<!-- Services -->

<section id="services" class="relative overflow-hidden pt-16 pb-16 lg:pt-20 lg:pb-20 bg-white dark:bg-dark">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle,rgba(55,88,249,0.16)_1.5px,transparent_1.5px)] opacity-60 dark:bg-[radial-gradient(circle,rgba(255,255,255,0.14)_1.5px,transparent_1.5px)] dark:opacity-25"
    style="background-size: 24px 24px;"
  >
  </div>
  <div class="pointer-events-none absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-primary/10 blur-3xl dark:bg-primary/20"></div>

  <div class="container relative">
    <div class="-mx-4 flex flex-wrap">
      <div class="w-full px-4">
        <div class="mb-10 lg:mb-12 text-center">
          <span class="mb-4 inline-block h-1 w-10 rounded-full bg-primary"></span>
          <h2 class="text-3xl text-dark dark:text-white sm:text-4xl md:text-[40px] md:leading-[1.2] font-pathway-gothic-one">
            {post.frontmatter.title}
          </h2>
        </div>
      </div>
    </div>
    <div class="mx-auto max-w-[980px]">
      <div class="-mx-4 flex flex-wrap justify-center">
        {
          blocks.map((block) => (
            <div class="w-full px-4 md:w-1/2 lg:w-1/3">
              <div class="wow fadeInUp group mb-8" data-wow-delay=".1s">
                <div class="relative z-10 mb-5 flex h-[52px] w-[52px] items-center justify-center rounded-[12px] bg-primary">
                  <span class="absolute top-0 left-0 -z-[1] mb-6 flex h-[52px] w-[52px] rotate-[25deg] items-center justify-center rounded-[12px] bg-primary bg-opacity-20 duration-300 group-hover:rotate-45" />
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#FFFFFF" viewBox="0 0 256 256">
                    <path d={block.path} />
                  </svg>
                </div>
                <h4 class="mb-2 text-lg font-bold text-dark dark:text-white">
                  {block.title}
                </h4>
                <p class="text-sm leading-relaxed text-body-color dark:text-dark-6">
                  {block.text}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
<!-- ====== Features Section End -->
