---
export interface Props {
  post: any;
}

const { post } = Astro.props;

const defaultFaces = [
  "/assets/hero/faces/face-01.jpg",
  "/assets/hero/faces/face-02.jpg",
  "/assets/hero/faces/face-03.jpg",
  "/assets/hero/faces/face-04.jpg",
  "/assets/hero/faces/face-05.jpg",
  "/assets/hero/faces/face-06.jpg",
  "/assets/hero/faces/face-07.jpg",
  "/assets/hero/faces/face-08.jpg",
];

const cmsFaces = (post.frontmatter?.faces ?? [])
  .map((face) => face?.image)
  .filter(Boolean);

const faces = cmsFaces.length > 0 ? cmsFaces : defaultFaces;
// Duplicated so the track can scroll a full loop (-50%) and wrap seamlessly.
const marqueeFaces = [...faces, ...faces];
---

<!-- Hero -->
<section id="home" class="relative overflow-hidden bg-white dark:bg-dark pt-32 pb-16 md:pt-36 lg:pt-44 lg:pb-24">
  <div class="container">
    <div class="-mx-4 flex flex-wrap items-center">
      <div class="w-full px-4">
        <div class="hero-content wow fadeInUp max-w-[700px]" data-wow-delay=".2s">
          {
            post.frontmatter && post.frontmatter.title ? (
              <h1 class="mb-6 text-4xl font-bold leading-tight text-dark dark:text-white sm:text-5xl sm:leading-tight lg:text-[56px] lg:leading-[1.15]">
                {post.frontmatter.title}
              </h1>
            ) : null
          }
          {
            post.frontmatter && post.frontmatter.description ? (
              <p class="mb-9 max-w-[600px] text-base font-medium text-body-color dark:text-dark-6 sm:text-lg sm:leading-[1.44]">
                {post.frontmatter.description}
              </p>
            ) : null
          }
          {
            post.frontmatter &&
            (post.frontmatter.ctaleft || post.frontmatter.ctaright) ? (
              <div class="mb-2 inline-flex flex-wrap overflow-hidden rounded-lg border border-stroke dark:border-dark-3">
                {post.frontmatter.ctaleftlink && post.frontmatter.ctaleft ? (
                  <a
                    href={post.frontmatter.ctaleftlink}
                    class="inline-flex items-center justify-center bg-white py-[14px] px-7 text-center text-base font-medium text-dark transition duration-300 ease-in-out hover:bg-gray-2 dark:bg-white dark:hover:bg-gray-2"
                  >
                    {post.frontmatter.ctaleft}
                  </a>
                ) : null}
                {post.frontmatter.ctarightlink && post.frontmatter.ctaright ? (
                  <a
                    href={post.frontmatter.ctarightlink}
                    class="inline-flex items-center justify-center bg-dark py-[14px] px-7 text-center text-base font-medium text-white transition duration-300 ease-in-out hover:bg-dark-2"
                  >
                    {post.frontmatter.ctaright}
                  </a>
                ) : null}
              </div>
            ) : null
          }
        </div>
      </div>
    </div>
  </div>

  <div class="hero-marquee mt-16 lg:mt-20">
    <div class="hero-marquee-track">
      {
        marqueeFaces.map((src) => (
          <div class="hero-marquee-item">
            <img src={src} alt="" loading="lazy" class="h-full w-full object-cover" />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero-marquee {
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  .hero-marquee-track {
    display: flex;
    width: max-content;
    animation: hero-marquee-scroll 36s linear infinite;
  }

  .hero-marquee-item {
    flex-shrink: 0;
    width: 130px;
    height: 170px;
  }

  @media (min-width: 640px) {
    .hero-marquee-item {
      width: 160px;
      height: 210px;
    }
  }

  @media (min-width: 1024px) {
    .hero-marquee-item {
      width: 190px;
      height: 250px;
    }
  }

  @keyframes hero-marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-marquee-track {
      animation: none;
    }
  }
</style>
