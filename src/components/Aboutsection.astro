---
export interface Props {
  post: any;
}

const { post } = Astro.props;

const paragraphs = [
  post.frontmatter.description1,
  post.frontmatter.description2,
  post.frontmatter.description3,
  post.frontmatter.description4,
  post.frontmatter.description5,
].filter(Boolean);
---
<!-- About -->
<section
  id="about"
  class="relative overflow-hidden bg-gray-1 dark:bg-dark-2 pt-20 pb-16 lg:pt-24 lg:pb-20"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle,rgba(55,88,249,0.16)_1.5px,transparent_1.5px)] opacity-60 dark:bg-[radial-gradient(circle,rgba(255,255,255,0.14)_1.5px,transparent_1.5px)] dark:opacity-25"
    style="background-size: 24px 24px;"
  >
  </div>
  <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-primary/10 blur-3xl dark:bg-primary/20"></div>

  <div class="container relative">
    <div class="wow fadeInUp mx-auto max-w-[720px] text-center" data-wow-delay=".2s">
      <span class="mb-4 inline-block h-1 w-10 rounded-full bg-primary"></span>
      <h2
        class="mb-8 text-3xl font-bold leading-tight text-dark dark:text-white sm:text-[40px] sm:leading-[1.2] font-pathway-gothic-one">
        {post.frontmatter.title}
      </h2>
      <div class="text-left text-base leading-relaxed text-body-color dark:text-dark-6">
        {paragraphs.map((paragraph) => (
          <p class="mb-6 last:mb-0">{paragraph}</p>
        ))}
      </div>
    </div>
  </div>
</section>
<!-- ====== About Section End -->
